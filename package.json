{
    "name": "traffic-cop",
    "private": true,
    "packageManager": "yarn@4.18.0",
    "workspaces": [
        "packages/*",
        "apps/*",
        "!**/dist"
    ],
    "scripts": {
        "build": "turbo build",
        "typecheck": "turbo typecheck",
