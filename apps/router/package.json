{
    "name": "@traffic-cop/router",
    "version": "0.1.0",
    "license": "MIT",
    "description": "traffic-cop: the broker daemon that owns Caddy and applies authorized routes",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Niikelion/traffic-cop.git",
        "directory": "apps/router"
    },
    "type": "module",
    "main": "dist/cli.js",
    "bin": {
        "traffic-cop-router": "dist/cli.js"
    },
    "files": [
        "/dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc --noEmit && tsdown",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write .",
        "start": "node dist/cli.js run",
        "test": "vitest run"
    },
    "dependencies": {
        "@signalbox/config": "^0.3.2",
        "@signalbox/core": "^0.5.1",
        "@signalbox/local-rpc": "^0.2.0",
        "@signalbox/permissions": "^0.4.0",
        "@signalbox/service-cli": "^0.6.0",
        "@traffic-cop/api": "workspace:*",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@gamedev-sensei/ts-config": "^2.1.0",
        "@types/node": "^22.10.2",
        "eslint": "^9.39.2",
        "prettier": "^3.8.1",
        "tsdown": "^0.15.7",
        "typescript": "^5.9.3",
        "vitest": "^2.1.9"
    }
}
