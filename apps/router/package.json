{
    "name": "@traffic-cop/router",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "description": "traffic-cop: the broker daemon that owns Caddy and applies authorized routes",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "traffic-cop-router": "dist/index.js"
    },
    "scripts": {
        "build": "tsc --noEmit && tsdown",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write .",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "@signalbox/core": "^0.5.1",
        "@signalbox/local-rpc": "^0.2.0",
        "@signalbox/permissions": "^0.4.0",
        "@traffic-cop/api": "workspace:*",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@gamedev-sensei/ts-config": "^2.1.0",
        "@types/node": "^22.10.2",
        "eslint": "^9.39.2",
        "prettier": "^3.8.1",
        "tsdown": "^0.15.7",
        "typescript": "^5.9.3"
    }
}
